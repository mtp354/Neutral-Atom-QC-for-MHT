# Simulated datasets stay local.
/data/*

# Ad-hoc pipeline runs.
/outputs/

# Local caches.
/.cache/

# QuTiP falls back to the working directory when its normal user cache is not
# writable. The solver redirects it to .cache/qutip/, but ignore the fallback.
/qutip_coeffs_*/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
dist/
build/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
